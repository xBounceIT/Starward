# Server
HOST=127.0.0.1
PORT=8080

# Dev mode: set to true to accept the dev-default secrets below.
# Default (unset) is PRODUCTION mode: STARWARD_AUTH_SECRET, STARWARD_MASTER_KEY,
# DATABASE_URL and a non-wildcard CORS_ORIGIN must be set to real values,
# otherwise the backend refuses to start.
STARWARD_DEV_MODE=true

# Dedicated PostgreSQL database URL
DATABASE_URL=postgres://starward:starward@127.0.0.1:5432/starward

# Shared HS256 secret used between TanStack Start Better Auth proxy and Rust backend
# Generate a strong random string in production (min 32 chars)
STARWARD_AUTH_SECRET=dev-starward-auth-secret-change-in-production-32chars

# Master encryption key for AES-256-GCM encryption of vault secrets at rest
# Generate a strong random string in production (min 32 chars)
STARWARD_MASTER_KEY=dev-starward-master-key-change-in-production-32chars

# Allowed CORS origin (TanStack Start frontend)
CORS_ORIGIN=http://localhost:3000

# Optional comma-separated emails automatically assigned the 'admin' RBAC role
# (The first registered user automatically receives 'admin' if no admin exists yet)
ADMIN_EMAILS=

RUST_LOG=starward_backend=debug,tower_http=info
