# ==============================================================================
# Starward Docker Compose Environment Variables
# Copy to .env and customize secrets before deploying in production:
#   cp .env.example .env
#   docker compose up --build -d          (dev: STARWARD_DEV_MODE=true is set
#                                          automatically by docker-compose.yml)
#   docker compose -f docker-compose.prod.yml up -d   (prod: all secrets below
#                                          are REQUIRED, no dev defaults)
# ==============================================================================

# --- Release / GHCR Image Tag (for docker-compose.prod.yml) ---
STARWARD_VERSION=latest

# --- Dedicated PostgreSQL ---
POSTGRES_USER=starward
POSTGRES_PASSWORD=starward-change-me
POSTGRES_DB=starward
POSTGRES_PORT=5432

# --- Ports & Public URL ---
FRONTEND_PORT=3000
BACKEND_PORT=8080
# Use http://0.0.0.0:3000 to accept connections from any PC on the network (LAN),
# or set a specific public URL in production (e.g. https://vault.example.com)
BETTER_AUTH_URL=http://0.0.0.0:3000
# Allowed CORS origin for the backend. REQUIRED by docker-compose.prod.yml:
# set it to the exact public frontend URL in production (e.g. https://vault.example.com)
CORS_ORIGIN=http://localhost:3000

# --- Security Secrets (CHANGE IN PRODUCTION - min 32 random chars each) ---
BETTER_AUTH_SECRET=change-me-better-auth-secret-minimum-32-chars
STARWARD_AUTH_SECRET=change-me-shared-jwt-secret-minimum-32-chars
STARWARD_MASTER_KEY=change-me-vault-aes256gcm-master-key-32-chars

# --- RBAC (Optional: comma-separated emails forced to Admin role; first user is Admin automatically) ---
ADMIN_EMAILS=

# --- Optional SSO Providers via Better Auth ---
# Generic Enterprise OIDC (Keycloak, Okta, Authentik, Auth0, Entra ID, ...)
SSO_OIDC_NAME=SSO Aziendale (OIDC)
SSO_OIDC_CLIENT_ID=
SSO_OIDC_CLIENT_SECRET=
SSO_OIDC_DISCOVERY_URL=

# Social / Cloud SSO
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
