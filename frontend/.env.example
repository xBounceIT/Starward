# App URL
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=dev-better-auth-secret-change-in-production-32chars

# Dedicated PostgreSQL database for Better Auth
# (Falls back to DATABASE_URL if AUTH_DATABASE_URL is not set)
DATABASE_URL=postgres://starward:starward@127.0.0.1:5432/starward
# AUTH_DATABASE_URL=postgres://starward:starward@127.0.0.1:5432/starward

# Rust Vault Backend connection & shared JWT signing secret
RUST_BACKEND_URL=http://127.0.0.1:8080
STARWARD_AUTH_SECRET=dev-starward-auth-secret-change-in-production-32chars

# --- SSO Providers via Better Auth (optional: fill to activate) ---

# 1. Generic Enterprise OIDC / SSO (Keycloak, Okta, Authentik, Entra ID, Auth0, etc.)
SSO_OIDC_NAME=SSO Aziendale (OIDC)
SSO_OIDC_CLIENT_ID=
SSO_OIDC_CLIENT_SECRET=
SSO_OIDC_DISCOVERY_URL=

# 2. Google SSO
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 3. GitHub SSO
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# 4. Microsoft Entra ID SSO
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
